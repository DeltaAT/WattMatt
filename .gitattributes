# Keep the working tree LF on every platform. Without this, a Windows checkout
# gets CRLF and `prettier --check` (endOfLine: lf) fails in CI on files nobody
# touched. It also keeps the .husky shell hooks executable by git's bash.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.woff binary
